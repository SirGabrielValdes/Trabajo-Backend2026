# Copie este archivo como .env y complete los valores reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# Clave secreta de Django. Generar una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-secreta-larga

# True solo en desarrollo; False en producción (EC2)
DEBUG=False

# Dominios / IP desde los que se accede al sitio (separados por coma)
ALLOWED_HOSTS=127.0.0.1,localhost,IP_PUBLICA_EC2

# Origen(es) confiables para formularios (Django Admin) cuando se accede por IP
CSRF_TRUSTED_ORIGINS=http://IP_PUBLICA_EC2

# Conexión a la base de datos MySQL / MariaDB
DB_NAME=zonaocio_db
DB_USER=zonaocio_user
DB_PASSWORD=cambiar-por-la-clave-del-usuario
DB_HOST=localhost
DB_PORT=3306
